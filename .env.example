# ---- Core ----
# Public URL of the app (used in emails, QR codes and payment callbacks)
APP_URL=http://localhost:3000
# PostgreSQL connection string (app role; row-level security applies to it)
DATABASE_URL=postgres://bmc_app:bmc_app@localhost:5432/buildmychurch
# Owner/superuser connection used only for migrations and seeding
DATABASE_ADMIN_URL=postgres://bmc_owner:bmc_owner@localhost:5432/buildmychurch
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
BLIND_INDEX_KEY=
SESSION_SECRET=

# ---- Email (choose one; "log" stores emails in the database outbox for development) ----
EMAIL_PROVIDER=log
EMAIL_FROM="Build My Church <no-reply@buildmychurch.com>"
RESEND_API_KEY=
SMTP_URL=

# ---- SMS ("log" for development, "termii" for production) ----
SMS_PROVIDER=log
TERMII_API_KEY=
TERMII_SENDER_ID=
# Your Termii account's base URL (Termii dashboard → API settings)
TERMII_BASE_URL=https://v3.api.termii.com
# Secret Termii signs delivery reports with (X-Termii-Signature)
TERMII_WEBHOOK_SECRET=

# ---- WhatsApp ("none", "log" for development, or "meta" for the WhatsApp Business Cloud API) ----
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Approved template with one body variable ({{1}}) that carries the message
WHATSAPP_TEMPLATE=church_announcement
# Price of one SMS unit (one page to one phone), in kobo
SMS_UNIT_PRICE_KOBO=400

# ---- Payments ("fake" shows a built-in test checkout; "paystack" for real payments) ----
PAYMENTS_PROVIDER=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- File storage ("local" writes to ./storage) ----
STORAGE_PROVIDER=local
