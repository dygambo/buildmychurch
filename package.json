{
  "name": "buildmychurch",
  "version": "0.1.0",
  "private": true,
  "description": "Build My Church: church management for Nigerian churches",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"next dev\" \"tsx watch scripts/worker.ts\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "geist": "^1.7.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
